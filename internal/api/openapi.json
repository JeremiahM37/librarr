{
  "openapi": "3.1.0",
  "info": {
    "title": "Librarr API",
    "description": "Self-hosted book, audiobook, and manga search and download manager — the *arr for books. The HTTP/JSON API powers both the SPA and any external tooling (CLI scripts, AI agents, *arr-family integrations).",
    "version": "1.x",
    "license": {"name": "MIT", "identifier": "MIT"}
  },
  "servers": [
    {"url": "http://localhost:5050", "description": "Default local install"}
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "API key for programmatic access. Also accepted via ?apikey= query parameter."
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "librarr_session",
        "description": "Set by POST /api/login. Used by the SPA."
      },
      "opdsBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic authentication for OPDS reader apps using existing enabled Librarr users."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": {"type": "boolean", "enum": [false]},
          "error":   {"type": "string"}
        }
      },
      "SearchResult": {
        "type": "object",
        "description": "A single search hit. Fields are populated per driver — direct-download drivers omit seeders/leechers; torrent drivers usually omit MD5.",
        "properties": {
          "title":        {"type": "string"},
          "author":       {"type": "string"},
          "source":       {"type": "string", "description": "Driver identifier (e.g. annas, gutenberg, prowlarr)."},
          "size":         {"type": "integer", "format": "int64"},
          "size_human":   {"type": "string"},
          "seeders":      {"type": "integer"},
          "leechers":     {"type": "integer"},
          "magnet_url":   {"type": "string"},
          "download_url": {"type": "string", "format": "uri"},
          "md5":          {"type": "string"},
          "info_hash":    {"type": "string"},
          "url":          {"type": "string", "format": "uri"},
          "cover_url":    {"type": "string", "format": "uri"},
          "format":       {"type": "string", "description": "epub, pdf, mobi, mp3, m4b, cbz, etc."},
          "score":        {"type": "integer", "description": "0-100 confidence score."},
          "media_type":   {"type": "string", "enum": ["ebook", "audiobook", "manga"]}
        }
      },
      "WishlistItem": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "id":         {"type": "integer", "format": "int64"},
          "title":      {"type": "string"},
          "author":     {"type": "string"},
          "media_type": {"type": "string", "enum": ["ebook", "audiobook", "manga"]}
        }
      },
      "PaginatedList": {
        "type": "object",
        "description": "Standard list response shape used across /api/library, /api/activity, etc.",
        "properties": {
          "items":  {"type": "array", "items": {"type": "object"}},
          "total":  {"type": "integer"},
          "limit":  {"type": "integer"},
          "offset": {"type": "integer"}
        }
      },
      "LibraryScanJob": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["pending", "scanning", "processing_metadata", "classifying", "completed", "failed", "cancelled"]},
          "progress": {"type": "object"},
          "error": {"type": "string"},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"}
        }
      },
      "LibraryScanCandidate": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "media_type": {"type": "string", "enum": ["ebook", "audiobook", "manga"]},
          "format": {"type": "string"},
          "path": {"type": "string"},
          "relative_path": {"type": "string"},
          "filename": {"type": "string"},
          "size": {"type": "integer", "format": "int64"},
          "modified_at": {"type": "string", "format": "date-time"},
          "title": {"type": "string"},
          "author": {"type": "string"},
          "series": {"type": "string"},
          "volume": {"type": "string"},
          "cover_url": {"type": "string"},
          "metadata": {"type": "object"},
          "classification": {"type": "string", "enum": ["new", "manual_review", "already_imported", "duplicate", "unsupported", "unreadable"]},
          "classification_reason": {"type": "string"},
          "existing_path": {"type": "string"},
          "destination_path": {"type": "string"},
          "manual_review": {"type": "object"},
          "duplicate": {"type": "object"},
          "error": {"type": "string"}
        }
      },
      "LibraryScanResult": {
        "type": "object",
        "properties": {
          "job_id": {"type": "string"},
          "status": {"type": "string"},
          "totals": {"type": "object"},
          "candidates": {"type": "array", "items": {"$ref": "#/components/schemas/LibraryScanCandidate"}},
          "warnings": {"type": "array", "items": {"type": "object"}},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"}
        }
      },
      "LibraryImportJob": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "scan_job_id": {"type": "string"},
          "status": {"type": "string", "enum": ["pending", "importing", "completed", "failed"]},
          "progress": {"type": "object"},
          "error": {"type": "string"},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"}
        }
      },
      "LibraryImportResult": {
        "type": "object",
        "properties": {
          "job_id": {"type": "string"},
          "scan_job_id": {"type": "string"},
          "status": {"type": "string"},
          "summary": {"type": "object"},
          "items": {"type": "array", "items": {"type": "object"}},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"}
        }
      },
      "DiagnosticStep": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string", "enum": ["success", "warning", "failed", "skipped"]},
          "duration_ms": {"type": "integer"},
          "message": {"type": "string"},
          "suggestion": {"type": "string"}
        }
      },
      "DiagnosticResult": {
        "type": "object",
        "properties": {
          "service": {"type": "string"},
          "status": {"type": "string", "enum": ["connected", "warning", "failed"]},
          "success": {"type": "boolean"},
          "duration_ms": {"type": "integer"},
          "summary": {"type": "string"},
          "steps": {"type": "array", "items": {"$ref": "#/components/schemas/DiagnosticStep"}}
        }
      },
      "NestedEbookPathRepairEntry": {
        "type": "object",
        "properties": {
          "book_id": {"type": "integer"},
          "book_title": {"type": "string"},
          "file_id": {"type": "integer"},
          "format": {"type": "string"},
          "source_path": {"type": "string"},
          "destination_path": {"type": "string"},
          "status": {"type": "string", "enum": ["ready", "collision", "missing", "unsafe", "already_repaired", "moved", "failed"]},
          "message": {"type": "string"},
          "class": {"type": "string", "enum": ["cataloged_normalized", "cataloged_legacy_only", "cataloged_unmanaged", "duplicate_physical_copy", "uncataloged", "collision", "missing_db_record", "unsafe"]},
          "matched_path": {"type": "string"},
          "matched_record": {"type": "string"},
          "hash": {"type": "string"},
          "size": {"type": "integer"}
        }
      },
      "NestedEbookPathRepairPlan": {
        "type": "object",
        "properties": {
          "success": {"type": "boolean"},
          "executed": {"type": "boolean"},
          "ebook_root": {"type": "string"},
          "legacy_root": {"type": "string"},
          "total_affected_files": {"type": "integer"},
          "total_affected_books": {"type": "integer"},
          "files_found_on_disk": {"type": "integer"},
          "correct_root_files": {"type": "integer"},
          "reconciliation": {"type": "object", "additionalProperties": {"type": "integer"}},
          "summary": {"type": "object", "additionalProperties": {"type": "integer"}},
          "entries": {"type": "array", "items": {"$ref": "#/components/schemas/NestedEbookPathRepairEntry"}},
          "legacy_root_removed": {"type": "boolean"},
          "removed_empty_folders": {"type": "array", "items": {"type": "string"}},
          "error": {"type": "string"}
        }
      }
    }
  },
  "security": [{"apiKey": []}, {"session": []}],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "description": "Liveness probe. Returns 200 if the binary is running. No auth required.",
        "security": [],
        "responses": {"200": {"description": "OK"}}
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This OpenAPI spec",
        "description": "Returns this OpenAPI 3.1 document. AI agents can fetch this to discover endpoints.",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {"application/json": {"schema": {"type": "object"}}}
          }
        }
      }
    },
    "/api/auth/status": {
      "get": {"summary": "Current auth state"}
    },
    "/api/login":  {"post": {"summary": "Session login", "security": []}},
    "/api/login/totp": {"post": {"summary": "TOTP 2FA verification step", "security": []}},
    "/api/logout": {"post": {"summary": "End session"}},
    "/api/register": {"post": {"summary": "Register new user (requires invite code when configured)", "security": []}},

    "/api/test/prowlarr": {
      "post": {
        "summary": "Run staged Prowlarr connection diagnostics",
        "description": "Checks configuration, URL validation, DNS, TCP, HTTPS, authentication, API validation, version, and latency. Secrets are not returned.",
        "responses": {
          "200": {"description": "Diagnostic result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiagnosticResult"}}}}
        }
      }
    },
    "/api/test/qbittorrent": {
      "post": {
        "summary": "Run staged qBittorrent connection diagnostics",
        "description": "Checks configuration, URL validation, DNS, TCP, HTTPS, authentication, API validation, version, and latency. Secrets are not returned.",
        "responses": {
          "200": {"description": "Diagnostic result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiagnosticResult"}}}}
        }
      }
    },

    "/api/search": {
      "get": {
        "summary": "Search ebooks across all configured sources",
        "parameters": [
          {"name": "q",      "in": "query", "required": true,  "schema": {"type": "string"}, "description": "Search query."},
          {"name": "author", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results":        {"type": "array", "items": {"$ref": "#/components/schemas/SearchResult"}},
                    "search_time_ms": {"type": "integer"},
                    "sources":        {"type": "array", "items": {"type": "object"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/search/audiobooks": {
      "get": {
        "summary": "Search audiobooks",
        "parameters": [
          {"name": "q",      "in": "query", "required": true,  "schema": {"type": "string"}},
          {"name": "author", "in": "query", "required": false, "schema": {"type": "string"}}
        ]
      }
    },
    "/api/search/manga": {
      "get": {
        "summary": "Search manga",
        "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string"}}]
      }
    },

    "/api/sources": {
      "get": {
        "summary": "List configured search sources + health",
        "description": "Returns each registered driver with enabled state, circuit-breaker status, last success/fail counters. Useful for AI agents debugging why a source isn't returning results."
      }
    },

    "/api/library": {
      "get": {
        "summary": "List ebooks in the library",
        "parameters": [
          {"name": "limit",  "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 50}},
          {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}},
          {"name": "type",   "in": "query", "schema": {"type": "string", "enum": ["ebook", "audiobook", "manga"]}},
          {"name": "tag",    "in": "query", "schema": {"type": "string"}, "description": "Filter by tag name."}
        ],
        "responses": {
          "200": {
            "description": "Paginated library items",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PaginatedList"}}}
          }
        }
      }
    },
    "/api/v1/books": {
      "get": {
        "summary": "List normalized Librarr 2.0 books",
        "description": "Returns one logical book per item with batched normalized enrichment. Requires LIBRARR_LIBRARY_REPOSITORY_MODE=normalized.",
        "parameters": [
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 50}},
          {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}},
          {"name": "search", "in": "query", "schema": {"type": "string"}},
          {"name": "media_type", "in": "query", "schema": {"type": "string", "enum": ["ebook", "audiobook", "comic", "manga"]}},
          {"name": "format", "in": "query", "schema": {"type": "string"}},
          {"name": "sort", "in": "query", "schema": {"type": "string", "enum": ["title", "author", "recently_added", "recently_updated"]}},
          {"name": "order", "in": "query", "schema": {"type": "string", "enum": ["asc", "desc"]}}
        ]
      }
    },
    "/api/v1/books/{id}": {
      "get": {
        "summary": "Get a normalized Librarr 2.0 book",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}]
      },
      "delete": {
        "summary": "Remove a normalized book from the catalog, optionally deleting managed files",
        "description": "Admin-only. With delete_files=false, removes the normalized catalog record and leaves files on disk. With delete_files=true, Librarr resolves attached files from the selected book, verifies each path is inside configured library roots, deletes files first, then removes catalog records. The client never supplies filesystem paths.",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}},
          {"name": "delete_files", "in": "query", "schema": {"type": "boolean", "default": false}}
        ],
        "responses": {
          "200": {"description": "Book removed or deleted"},
          "400": {"description": "Invalid or unsafe attached file path"},
          "403": {"description": "Admin access required"},
          "404": {"description": "Book not found"},
          "409": {"description": "One or more files could not be deleted; catalog record was retained"}
        }
      }
    },
    "/api/v1/books/{id}/metadata": {
      "get": {
        "summary": "Get normalized metadata for a Librarr 2.0 book",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}]
      },
      "patch": {
        "summary": "Apply manual metadata overrides for a Librarr 2.0 book",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}]
      }
    },
    "/api/v1/books/{id}/provenance": {
      "get": {
        "summary": "Get metadata provenance and competing evidence for a Librarr 2.0 book",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}]
      }
    },
    "/api/v1/books/{id}/files": {
      "get": {
        "summary": "List all files attached to a normalized book",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}]
      }
    },
    "/api/v1/books/{id}/editions": {
      "get": {
        "summary": "List editions for a normalized book",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}]
      }
    },
    "/api/v1/books/{id}/cover": {
      "get": {
        "summary": "Serve a stored local cover image for a normalized book",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}]
      }
    },
    "/api/v1/library/summary": {
      "get": {
        "summary": "Return normalized library totals and format distribution",
        "description": "Returns native counts from normalized Librarr 2.0 tables. Requires LIBRARR_LIBRARY_REPOSITORY_MODE=normalized."
      }
    },
    "/api/v1/library/repairs/nested-ebook-paths": {
      "get": {
        "summary": "Preview nested ebook path repair",
        "description": "Admin-only dry run for cataloged ebook files under a repeated ebook root such as /books/ebooks/ebooks. No files or database paths are changed.",
        "responses": {
          "200": {"description": "Repair preview", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NestedEbookPathRepairPlan"}}}},
          "400": {"description": "Repair cannot be planned", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"description": "Admin access required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "post": {
        "summary": "Run nested ebook path repair",
        "description": "Admin-only explicit repair. Moves only ready entries, updates normalized file paths through LibraryService, skips collisions/missing/unsafe entries, and removes only empty legacy directories.",
        "responses": {
          "200": {"description": "Repair execution result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NestedEbookPathRepairPlan"}}}},
          "400": {"description": "Repair cannot be planned", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"description": "Admin access required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/library/scan": {
      "post": {
        "summary": "Start a Librarr 2.0 library scan job",
        "description": "Starts a read-only scan of the configured Ebook, Audiobook, and Manga library folders and returns a review job id. Phase 1 performs no imports or database writes.",
        "responses": {
          "202": {
            "description": "Scan accepted",
            "content": {"application/json": {"schema": {"type": "object", "properties": {
              "success": {"type": "boolean"},
              "job_id": {"type": "string"},
              "job": {"$ref": "#/components/schemas/LibraryScanJob"}
            }}}}
          },
          "409": {"description": "A scan is already running", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/library/scan/{job_id}": {
      "get": {
        "summary": "Get library scan job progress",
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Scan job", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LibraryScanJob"}}}},
          "404": {"description": "Unknown scan job", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/library/scan/{job_id}/results": {
      "get": {
        "summary": "Get completed library scan review payload",
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Completed review payload", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LibraryScanResult"}}}},
          "409": {"description": "Scan results are not ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "Unknown scan job", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/library/scan/{job_id}/cover/{candidate_id}": {
      "get": {
        "summary": "Serve a temporary local cover image extracted during scan review",
        "description": "Returns user-owned artwork extracted from a local scan candidate when available. Does not download or proxy external covers.",
        "parameters": [
          {"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "candidate_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Local cover image"},
          "404": {"description": "Cover not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/library/scan/{job_id}/resolve": {
      "post": {
        "summary": "Resolve or edit a scan review candidate in memory",
        "description": "Marks a manual_review candidate as ready_to_import using suggested metadata, or applies manually edited metadata to a manual_review or ready candidate before import. This does not write library data.",
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "properties": {
            "id": {"type": "string"},
            "action": {"type": "string", "enum": ["use_suggested", "edit_metadata"]},
            "title": {"type": "string"},
            "subtitle": {"type": "string"},
            "author": {"type": "string"},
            "series": {"type": "string"},
            "series_number": {"type": "string"},
            "publisher": {"type": "string"},
            "publication_year": {"type": "string"},
            "isbn": {"type": "string"},
            "language": {"type": "string"},
            "description": {"type": "string"},
            "tags": {"type": "array", "items": {"type": "string"}},
            "library": {"type": "string"}
          }, "required": ["id", "action"]}}}
        },
        "responses": {
          "200": {"description": "Updated scan review payload", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LibraryScanResult"}}}},
          "400": {"description": "Invalid resolution", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "Unknown scan job", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/library/import": {
      "post": {
        "summary": "Start a Librarr 2.0 library import job from scan review results",
        "description": "Imports only ready_to_import candidates from a completed scan review. Duplicates, already imported, unsupported, and unreadable entries are never imported.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "properties": {
            "scan_job_id": {"type": "string"},
            "candidate_ids": {"type": "array", "items": {"type": "string"}},
            "all_ready": {"type": "boolean"}
          }, "required": ["scan_job_id"]}}}
        },
        "responses": {
          "202": {"description": "Import accepted", "content": {"application/json": {"schema": {"type": "object", "properties": {
            "success": {"type": "boolean"},
            "job_id": {"type": "string"},
            "job": {"$ref": "#/components/schemas/LibraryImportJob"}
          }}}}},
          "400": {"description": "No ready candidates selected", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "409": {"description": "An import is already running", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/library/import/{job_id}": {
      "get": {
        "summary": "Get library import job progress",
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Import job", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LibraryImportJob"}}}},
          "404": {"description": "Unknown import job", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/library/import/{job_id}/results": {
      "get": {
        "summary": "Get completed library import result",
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Completed import result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LibraryImportResult"}}}},
